[Unit]
Description=Podman Start All Containers With Restart Policy Set To Always Or Unless-Stopped
Documentation=man:podman-start(1)
StartLimitIntervalSec=0
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
Environment=LOGGING="--log-level=info"
ExecStart=/usr/local/bin/podman $LOGGING start --all --filter should-start-on-boot=true
ExecStop=/usr/local/bin/podman  $LOGGING stop --service --all

[Install]
WantedBy=default.target
